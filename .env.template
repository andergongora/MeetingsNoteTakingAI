# Google Gemini API Key (required for meeting analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Whisper Model Size (optional - default: base)
# Options: tiny, base, small, medium, large
# tiny:   Fast, less accurate (~1GB RAM)
# base:   Good balance (~1GB RAM) - RECOMMENDED
# small:  Better quality (~2GB RAM)
# medium: High quality (~5GB RAM)
# large:  Best quality (~10GB RAM)
WHISPER_MODEL=base

# Gemini Model (optional - default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
